  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.6",
    "@radix-ui/react-dialog": "^1.1.19",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
